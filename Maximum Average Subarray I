double findMaxAverage(int* nums, int numsSize, int k) {
    double sum=0;
    double avg;
    double max;
    for(int i=0;i<k;i++){
        sum+=*(nums+i);
    }
    avg=sum/k;
    max=avg;
    for(int i=k;i<numsSize;i++){
        sum=sum-*(nums+i-k)+*(nums+i);
        avg=sum/k;
        if(avg>max){
            max=avg;
        }
    }
    return max;
}
